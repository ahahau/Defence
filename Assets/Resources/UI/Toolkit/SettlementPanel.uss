.settlement-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: var(--scrim);
}

.settlement-card {
    width: 1040px;
    max-width: 96%;
    max-height: 92%;
    padding: 20px 24px 18px 24px;
    background-color: var(--surface);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: var(--edge);
    border-right-color: var(--edge);
    border-bottom-color: var(--edge);
    border-left-color: var(--edge);
    transition-property: opacity, translate;
    transition-duration: 130ms, 130ms;
}

/* 등장 시작 상태. 기본 상태로 돌아가며 전환되므로, 연출이 걸리지 않아도 카드는 보인다. */
.settlement-card.is-entering {
    opacity: 0;
    translate: 0 14px;
}

.settlement-title {
    color: var(--accent-soft);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-bottom: 10px;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--edge-soft);
}

.settlement-columns {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.ledger-scroll {
    flex-grow: 1;
    padding-right: 14px;
}

.ledger-pair {
    flex-direction: row;
}

.ledger-column {
    flex-grow: 1;
    flex-basis: 0;
    padding-right: 12px;
}

.ledger-heading, .section-heading, .loan-subheading {
    color: var(--accent);
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.loan-subheading {
    margin-top: 12px;
    font-size: 13px;
}

.ledger-list {
    margin-bottom: 4px;
}

.ledger-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 2px;
}

/* 수입은 초록, 지출은 붉게 — 금액을 읽기 전에 어느 쪽인지가 먼저 보여야 한다. */
.ledger-row-label, .ledger-row-amount {
    font-size: 13px;
    color: var(--text-body);
}

.ledger-row-amount {
    -unity-text-align: middle-right;
}

.is-gain .ledger-row-label, .is-gain .ledger-row-amount, .is-gain .ledger-empty {
    color: var(--gain);
}

.is-loss .ledger-row-label, .is-loss .ledger-row-amount, .is-loss .ledger-empty {
    color: var(--loss);
}

.ledger-row-label {
    flex-shrink: 1;
}

.ledger-empty {
    font-size: 13px;
}

.ledger-total {
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: var(--edge-soft);
}

.income-total { color: var(--gain); }
.expense-total { color: var(--loss); }

/* 요약은 기존 정산표처럼 가운데로 모은다. 장부는 왼쪽에서 읽고, 결론은 가운데서 본다. */
.summary-block {
    align-items: center;
    margin-top: 12px;
}

.net-label {
    font-size: 21px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.net-label.is-positive { color: var(--gain-strong); }
.net-label.is-negative { color: var(--loss-strong); }

.deferred-label {
    color: var(--text-dim);
    font-size: 12px;
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.note-list {
    margin-bottom: 6px;
    align-items: center;
}

.note-line {
    color: var(--text-body);
    font-size: 13px;
    margin-bottom: 2px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.note-line.is-good { color: var(--gain); }
.note-line.is-caution { color: var(--warn); }
.note-line.is-danger { color: var(--loss-strong); }
.note-line.is-accent { color: var(--accent-soft); }

.fatigue-section {
    margin-top: 6px;
    align-items: center;
}

.fatigue-list {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.fatigue-chip {
    color: var(--text-body);
    font-size: 12px;
    padding: 2px 8px;
    margin-right: 5px;
    margin-bottom: 4px;
    background-color: var(--surface-control-quiet);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--edge-quiet);
    border-right-color: var(--edge-quiet);
    border-bottom-color: var(--edge-quiet);
    border-left-color: var(--edge-quiet);
}

.fatigue-chip.is-tired { color: var(--warn); }
.fatigue-chip.is-exhausted { color: var(--loss-strong); }

.unlock-section {
    margin-top: 10px;
    border-top-width: 1px;
    border-top-color: var(--edge-soft);
    padding-top: 8px;
}

/* 기존 정산표처럼 두 머리글을 좌우로 세운다. 펼친 목록은 그 아래 한 자리를 같이 쓴다. */
.unlock-headers {
    flex-direction: row;
}

.unlock-header {
    flex-grow: 1;
    flex-basis: 0;
    height: 30px;
    margin: 0 3px 0 3px;
    color: var(--accent-soft);
    font-size: 13px;
    -unity-text-align: middle-center;
    background-color: var(--surface-control);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--edge-soft);
    border-right-color: var(--edge-soft);
    border-bottom-color: var(--edge-soft);
    border-left-color: var(--edge-soft);
}

/*
 * 해금 목록은 20줄 가까이 되기도 한다. 높이를 묶지 않으면 카드 아래쪽을 통째로 차지해서
 * 정작 오늘 번 돈이 뒤로 밀린다. 목록 안에서 스크롤하게 두고 자리는 고정한다.
 */
.unlock-list {
    max-height: 250px;
    padding-top: 6px;
    padding-left: 3px;
}

.unlock-row {
    color: var(--text-dim);
    font-size: 12px;
    margin-bottom: 2px;
    white-space: normal;
}

.unlock-row.is-unlocked { color: var(--text-body); }

/* 상품이 늘거나 창이 작아도 상환 버튼이 잘리지 않도록 창구 쪽도 스크롤한다. */
.loan-pane {
    width: 320px;
    flex-shrink: 0;
    padding: 14px;
    background-color: var(--surface-inset);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--edge-soft);
    border-right-color: var(--edge-soft);
    border-bottom-color: var(--edge-soft);
    border-left-color: var(--edge-soft);
}

.loan-debt {
    color: var(--loss);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.loan-line {
    color: var(--text-body);
    font-size: 12px;
    margin-bottom: 2px;
    white-space: normal;
}

.loan-terms {
    color: var(--text-dim);
    margin-top: 6px;
}

.loan-window {
    color: var(--warn);
    font-size: 12px;
    margin-top: 8px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: var(--edge-quiet);
    white-space: normal;
}

.loan-product-list { margin-top: 2px; }

.loan-product-button {
    height: 46px;
    margin-top: 4px;
    padding: 4px 8px;
    color: var(--text-body);
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-left;
    background-color: var(--surface-control-quiet);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--edge-quiet);
    border-right-color: var(--edge-quiet);
    border-bottom-color: var(--edge-quiet);
    border-left-color: var(--edge-quiet);
}

.loan-product-button.is-selected {
    color: var(--accent);
    background-color: var(--surface-control);
    border-top-color: var(--edge);
    border-right-color: var(--edge);
    border-bottom-color: var(--edge);
    border-left-color: var(--edge);
}

.loan-button {
    height: 34px;
    margin-top: 6px;
    color: var(--text);
    font-size: 13px;
    background-color: var(--surface-control);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--edge-soft);
    border-right-color: var(--edge-soft);
    border-bottom-color: var(--edge-soft);
    border-left-color: var(--edge-soft);
}

.loan-button:disabled { opacity: 0.45; }
.loan-product-button:disabled { opacity: 0.45; }

.loan-feedback {
    color: var(--warn);
    font-size: 12px;
    margin-top: 8px;
    white-space: normal;
}

.close-button {
    width: 280px;
    height: 42px;
    align-self: center;
    margin-top: 14px;
    color: var(--text);
    font-size: 16px;
    background-color: var(--confirm);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--confirm-edge);
    border-right-color: var(--confirm-edge);
    border-bottom-color: var(--confirm-edge);
    border-left-color: var(--confirm-edge);
}
