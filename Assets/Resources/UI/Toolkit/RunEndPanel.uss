.run-end-root { display:none; position:absolute; left:0; top:0; right:0; bottom:0; align-items:center; justify-content:center; background-color:var(--scrim); }
.run-end-card { width:560px; padding:30px; background-color:var(--surface); border-width:2px; border-color:var(--edge); align-items:center; }
.run-end-title { color:var(--accent); font-size:28px; -unity-font-style:bold; -unity-text-align:middle-center; }
.run-end-headline { color:var(--text-body); font-size:14px; white-space:normal; -unity-text-align:middle-center; margin-top:10px; height:40px; flex-shrink:0; }
.run-end-divider { height:1px; align-self:stretch; background-color:var(--edge-quiet); margin-top:18px; margin-bottom:14px; }
.run-end-summary { color:var(--text-dim); font-size:13px; white-space:normal; -unity-text-align:middle-center; height:60px; flex-shrink:0; }
/* 진행도·새로 열린 콘텐츠. 해금 이름이 길어도 카드 크기가 변하지 않게 높이를 고정한다. */
.run-end-meta { color:var(--text-body); font-size:13px; white-space:normal; -unity-text-align:middle-center; height:76px; flex-shrink:0; margin-top:10px; overflow:hidden; }
.run-end-actions { flex-direction:row; justify-content:center; margin-top:22px; height:42px; flex-shrink:0; }
.run-end-retry { width:200px; height:42px; color:var(--text); background-color:var(--confirm); border-width:1px; border-color:var(--confirm-edge); }
.run-end-to-title { width:200px; height:42px; margin-left:12px; color:var(--text); background-color:var(--surface); border-width:1px; border-color:var(--edge); }
/* 끝난 판은 제목 → 통계 → 진행도 → 버튼 순서로 하나씩 드러난다. */
.run-end-stage { opacity:0; transition-property:opacity; transition-duration:0.45s; }
.run-end-stage--shown { opacity:1; }
