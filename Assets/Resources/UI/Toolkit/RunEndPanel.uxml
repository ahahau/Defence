<ui:UXML xmlns:ui="UnityEngine.UIElements">
 <Style src="Theme.uss" /><Style src="RunEndPanel.uss" />
 <ui:VisualElement name="run-end-root" class="ui-theme run-end-root"><ui:VisualElement class="run-end-card">
  <ui:Label name="run-end-title" class="run-end-title run-end-stage" /><ui:Label name="run-end-headline" class="run-end-headline run-end-stage" />
  <ui:VisualElement class="run-end-divider" /><ui:Label name="run-end-summary" class="run-end-summary run-end-stage" />
  <ui:Label name="run-end-meta" class="run-end-meta run-end-stage" />
  <ui:VisualElement name="run-end-actions" class="run-end-actions run-end-stage">
   <ui:Button name="run-end-retry" text="새 런 시작" class="run-end-retry" />
   <ui:Button name="run-end-to-title" text="타이틀로" class="run-end-to-title" />
  </ui:VisualElement>
 </ui:VisualElement></ui:VisualElement>
</ui:UXML>
