.gameplay-root { flex-grow: 1; color: var(--text-body); }
.top-bar { height: 92px; padding: 14px 22px 12px; flex-direction: row; justify-content: space-between; background-color: rgba(10, 7, 5, 0.92); border-bottom-width: 1px; border-bottom-color: var(--edge-quiet); }
.brand-block { width: 165px; justify-content: center; }
.brand-title { color: var(--accent); font-size: 20px; -unity-font-style: bold; }
.brand-subtitle { color: var(--text-dim); font-size: 12px; margin-top: 3px; }
.status-strip { flex-direction: row; flex-grow: 1; justify-content: center; }
.status-chip { width: 148px; margin-left: 5px; margin-right: 5px; padding-left: 11px; justify-content: center; background-color: var(--surface-control-quiet); border-left-width: 2px; border-left-color: var(--edge-quiet); }
.status-chip.is-gold { border-left-color: var(--accent); } .status-chip.is-debt { border-left-color: var(--loss); } .status-chip.is-magic { border-left-color: rgb(110, 180, 235); } .status-chip.is-revival { border-left-color: var(--warn); } .status-chip.is-grade { border-left-color: rgb(187, 139, 220); } .status-chip.is-threat { border-left-color: var(--warn); }
.chip-title { color: var(--text-dim); font-size: 11px; } .chip-value { color: var(--text); font-size: 14px; -unity-font-style: bold; margin-top: 2px; } .status-chip.is-debt .chip-value { color: var(--loss); }
.speed-card { width: 212px; flex-direction: row; align-items: center; justify-content: flex-end; }
.speed-button, .action-button, .quiet-button { color: var(--text-body); background-color: var(--surface-control); border-width: 1px; border-color: var(--edge-quiet); }
.speed-button { height: 38px; min-width: 55px; margin-left: 4px; font-size: 12px; } .speed-button.is-selected { color: var(--accent); background-color: var(--confirm); border-color: var(--edge); }
.map-overlay { position: absolute; top: 106px; bottom: 166px; left: 18px; right: 326px; }
.selection-popover { display: none; width: 250px; padding: 12px; background-color: var(--surface); border-width: 1px; border-color: var(--edge-soft); }
.selection-title { color: var(--text-dim); font-size: 12px; white-space: normal; } .quiet-button { align-self: flex-start; margin-top: 8px; height: 28px; font-size: 11px; }
.node-detail-panel { display: none; position: absolute; top: 106px; bottom: 166px; left: 18px; width: 276px; padding: 15px; background-color: rgba(14, 9, 6, 0.97); border-width: 1px; border-color: var(--edge-soft); }
.detail-heading { flex-direction: row; justify-content: space-between; align-items: flex-start; } .detail-heading .quiet-button { margin-top: 0; } .detail-title { color: var(--accent); font-size: 16px; -unity-font-style: bold; } .detail-state { color: var(--text-body); font-size: 12px; margin-top: 10px; white-space: normal; } .detail-divider { height: 1px; margin-top: 13px; margin-bottom: 13px; background-color: var(--edge-quiet); } .detail-section-title { color: var(--text-dim); font-size: 11px; margin-bottom: 7px; } .detail-line { color: var(--text-body); font-size: 12px; margin-bottom: 6px; } .detail-facility-usage { color: var(--text-dim); } .detail-facility-status { color: var(--accent-soft); white-space: normal; } .detail-hint { color: var(--warn); font-size: 11px; white-space: normal; }
.installation-panel { display: none; position: absolute; left: 310px; bottom: 166px; width: 310px; max-height: 350px; padding: 15px; background-color: rgba(14, 9, 6, 0.98); border-width: 1px; border-color: var(--edge-soft); } .installation-list { flex-grow: 1; margin-top: 12px; } .installation-row { min-height: 44px; margin-bottom: 6px; padding: 7px; color: var(--text-body); background-color: var(--surface-control); border-width: 1px; border-color: var(--edge-quiet); font-size: 12px; white-space: normal; }
.right-rail { position: absolute; top: 106px; bottom: 166px; right: 18px; width: 292px; padding: 14px; background-color: rgba(14, 9, 6, 0.96); border-width: 1px; border-color: var(--edge-quiet); }
.rail-heading, .drawer-heading { flex-direction: row; justify-content: space-between; align-items: center; } .rail-title { color: var(--accent-soft); font-size: 14px; -unity-font-style: bold; } .rail-count { color: var(--warn); font-size: 11px; }
.party-list { height: 155px; margin-top: 8px; } .party-row { min-height: 30px; flex-direction: row; justify-content: space-between; padding: 7px 2px; border-bottom-width: 1px; border-bottom-color: rgba(92, 68, 38, 0.55); } .party-name { color: var(--text-body); font-size: 12px; } .party-risk { color: var(--warn); font-size: 11px; }
.rail-divider { height: 1px; margin-top: 12px; margin-bottom: 12px; background-color: var(--edge-quiet); } .log-title { margin-bottom: 7px; } .activity-log { flex-grow: 1; } .log-line { color: var(--text-dim); font-size: 11px; white-space: normal; margin-bottom: 8px; } .log-line.is-alert { color: var(--warn); }
.bottom-area { position: absolute; height: 148px; bottom: 0; left: 0; right: 0; } .management-banner { height: 30px; align-items: center; justify-content: center; background-color: rgba(29, 18, 11, 0.95); border-top-width: 1px; border-top-color: var(--edge-quiet); } .management-label { color: var(--text-dim); font-size: 11px; } .management-label.is-management { color: var(--accent); } .management-label.is-pause-locked { color: var(--loss); }
.bottom-bar { flex-grow: 1; flex-direction: row; padding: 12px 22px 14px; background-color: rgba(10, 7, 5, 0.94); } .action-group { width: 335px; } .action-group.time-actions { width: 215px; margin-left: 14px; } .action-group-title { color: var(--text-dim); font-size: 11px; margin-bottom: 7px; } .action-buttons { flex-direction: row; } .action-button { min-width: 72px; height: 46px; margin-right: 5px; font-size: 12px; white-space: normal; } .action-button:disabled { opacity: 0.42; }
.unit-drawer { flex-grow: 1; margin-left: 18px; margin-right: 18px; padding-left: 15px; border-left-width: 1px; border-left-color: var(--edge-quiet); } .drawer-heading .quiet-button { margin-top: 0; } .drawer-summary { color: var(--text-body); font-size: 12px; margin-top: 10px; }
.revival-queue { color: var(--warn); font-size: 11px; height: 16px; margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.roster-list { display: none; height: 52px; margin-top: 6px; } .unit-row { min-width: 120px; height: 34px; margin-right: 5px; color: var(--text-body); background-color: var(--surface-control); border-width: 1px; border-color: var(--edge-quiet); font-size: 11px; } .unit-row:disabled { opacity: 0.42; }
.unit-row.is-selected { color: var(--accent); border-color: var(--edge); background-color: var(--confirm); }
.unit-detail { display: none; flex-direction: row; justify-content: space-between; margin-top: 5px; } .unit-detail-name { color: var(--accent-soft); font-size: 12px; -unity-font-style: bold; } .unit-detail-state { color: var(--text-dim); font-size: 11px; }
.toast-host { position: absolute; right: 330px; top: 112px; width: 340px; align-items: flex-end; } .toast { margin-bottom: 6px; padding: 9px 12px; background-color: var(--surface); border-left-width: 3px; border-left-color: var(--edge-soft); color: var(--text-body); font-size: 12px; } .toast.is-alert { border-left-color: var(--warn); color: var(--warn); }
.pause-menu-overlay { display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: var(--scrim); }
.pause-menu-card, .pause-settings-card { width: 340px; padding: 22px; background-color: var(--surface); border-width: 2px; border-color: var(--edge); }
.pause-menu-title { color: var(--accent); font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-center; }
.pause-menu-status { color: var(--text-dim); font-size: 12px; white-space: normal; -unity-text-align: middle-center; margin-top: 9px; margin-bottom: 14px; }
.pause-run-summary { color: var(--accent-soft); font-size: 12px; white-space: normal; margin-bottom: 8px; -unity-text-align: middle-center; }
.pause-menu-button { height: 42px; margin-top: 6px; color: var(--text-body); background-color: var(--surface-control); border-width: 1px; border-color: var(--edge-quiet); }
.pause-menu-primary { color: var(--text); background-color: var(--confirm); border-color: var(--confirm-edge); }
.pause-menu-danger { color: var(--loss); margin-top: 18px; }
.pause-settings-card, .pause-help-card { display: none; position: absolute; width: 310px; margin-left: 420px; }
.pause-setting-label { color: var(--text-body); font-size: 12px; margin-top: 14px; }
.pause-setting-value { color: var(--accent); font-size: 12px; -unity-text-align: middle-right; margin-top: 3px; }
.pause-help-tabs { flex-direction: row; margin-top: 13px; }
.pause-help-tab { min-width: 62px; height: 28px; margin-right: 3px; color: var(--text-dim); background-color: var(--surface-control-quiet); border-width: 1px; border-color: var(--edge-quiet); font-size: 11px; }
.pause-help-tab.is-selected { color: var(--accent); background-color: var(--surface-control); border-color: var(--edge); }
.pause-help-title { color: var(--accent-soft); font-size: 14px; -unity-font-style: bold; margin-top: 16px; }
.pause-help-body { color: var(--text-body); font-size: 12px; white-space: normal; margin-top: 8px; }
.detail-facility-queue { height: 40px; flex-shrink: 0; white-space: normal; overflow: hidden; }
