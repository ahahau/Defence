/*
 * UI Toolkit 화면들이 함께 쓰는 색 토큰.
 *
 * 값은 Super GUI 팩의 Silver(남색 창)·Black(회색 칸) 조각에서 뽑았다. 새 화면의 DesignToken.uss와
 * 같은 팔레트다 — 전환이 끝날 때까지 새 화면과 옛 화면이 한 화면에 같이 뜬다.
 * 수입·지출·경고처럼 뜻이 있는 색은 예전 값을 그대로 둔다.
 *
 * 변수는 상속되므로 각 문서의 가장 바깥 요소에 `ui-theme` 클래스를 붙여야 한다.
 * `:root`를 쓰지 않는 이유는 여러 UIDocument가 한 패널을 공유해 어느 요소가 루트인지
 * 문서마다 달라지기 때문이다.
 */
.ui-theme {
    /* 바닥 */
    --scrim: rgba(20, 19, 33, 0.86);
    --surface: rgb(77, 83, 120);
    --surface-inset: rgb(75, 77, 78);
    --surface-control: rgb(80, 83, 109);
    --surface-control-quiet: rgb(51, 50, 61);

    /* 화면 가장자리 막대(상단·하단 바)와 오른쪽 기록판 바닥 */
    --bar: rgba(33, 32, 52, 0.94);
    --bar-strip: rgba(51, 50, 61, 0.95);
    --page: rgb(33, 32, 52);

    /* 테두리 */
    --edge: rgb(177, 192, 204);
    --edge-soft: rgba(137, 142, 180, 0.85);
    --edge-quiet: rgb(92, 97, 101);
    --edge-faint: rgba(92, 97, 101, 0.55);

    /* 글자 */
    --text: rgb(246, 246, 246);
    --text-body: rgb(216, 220, 234);
    --text-dim: rgb(169, 174, 218);
    --accent: rgb(255, 194, 79);
    --accent-soft: rgb(242, 212, 148);

    /* 장부 — 수입과 지출은 색으로 먼저 읽힌다 */
    --gain: rgb(138, 230, 145);
    --gain-strong: rgb(115, 242, 140);
    --loss: rgb(255, 161, 138);
    --loss-strong: rgb(255, 115, 102);

    /* 경고 */
    --warn: rgb(224, 176, 112);
    --danger: rgb(230, 71, 41);
    --surface-danger: rgb(96, 30, 22);

    /* 확정·선택 버튼 */
    --confirm: rgb(110, 115, 149);
    --confirm-edge: rgb(177, 192, 204);

    /* HUD 칩 왼쪽 줄 — 칸마다 뜻이 다른 색 */
    --chip-magic: rgb(110, 180, 235);
    --chip-grade: rgb(187, 139, 220);

    /* 테두리 그림에 곱하는 색. 흰색이면 그림 그대로다. 새 화면의 DesignToken과 같은 값이다. */
    --skin-frame: rgb(255, 255, 255);
    --skin-frame-hover: rgb(242, 212, 148);
    --skin-frame-pressed: rgb(137, 142, 180);
    /* 잘린 모서리 창은 그림이 바탕까지 칠한다. 요소 바탕을 비워야 모서리 밖이 칠해지지 않는다. */
    --skin-window-fill: rgba(0, 0, 0, 0);
}

/*
 * 테두리(Super GUI 팩 Silver·Black, Assets/GameModules/UI/Skin/Silver).
 *
 * 새 화면의 .panel/.btn과 같은 그림을 옛 화면에도 입힌다. 둘이 한 화면에 같이 뜬다.
 * 그림이 선 테두리를 대신하므로 두께를 0으로 둔다. .ui-theme를 앞에 붙여 각 화면 USS의
 * 테두리 두께보다 우선하게 한다. 칩의 왼쪽 색 줄처럼 색이 뜻을 가진 선은 건드리지 않는다.
 */
.ui-theme .unity-button {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-image: url("project://database/Assets/GameModules/UI/Skin/Silver/ButtonFrame.png");
    -unity-slice-left: 9;
    -unity-slice-right: 9;
    -unity-slice-top: 9;
    -unity-slice-bottom: 9;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: var(--skin-frame);
}

.ui-theme .unity-button:enabled:hover { -unity-background-image-tint-color: var(--skin-frame-hover); }
.ui-theme .unity-button:enabled:active { -unity-background-image-tint-color: var(--skin-frame-pressed); }

/* 지도 위에 늘 떠 있는 판은 네모 창이다. */
.ui-theme .selection-popover,
.ui-theme .right-rail {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-image: url("project://database/Assets/GameModules/UI/Skin/Silver/PanelFrame.png");
    -unity-slice-left: 10;
    -unity-slice-right: 10;
    -unity-slice-top: 10;
    -unity-slice-bottom: 10;
    -unity-slice-scale: 2px;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: var(--skin-frame);
}

/* 큰 모달 창은 오른쪽 위·왼쪽 아래가 잘린 창이다. 그림이 바탕까지 칠한다. */
.ui-theme .settlement-card,
.ui-theme .run-end-card,
.ui-theme .policy-card,
.ui-theme .title-card,
.ui-theme .settings-card,
.ui-theme .pause-menu-card,
.ui-theme .pause-settings-card {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: var(--skin-window-fill);
    background-image: url("project://database/Assets/GameModules/UI/Skin/Silver/WindowFrame.png");
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 2px;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: var(--skin-frame);
}

.ui-theme .loan-pane {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: var(--surface-inset);
    background-image: url("project://database/Assets/GameModules/UI/Skin/Silver/BoxFrame.png");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: var(--skin-frame);
}

/*
 * 공통 컨트롤 반응.
 *
 * 누를 수 있는 것과 없는 것이 눈으로 구분돼야 한다. UGUI 버튼은 Selectable이 알아서
 * 색을 바꿔 줬지만 UI Toolkit은 기본값이 거의 없어서, 손이 닿았을 때의 반응을 여기서 한 번만 정한다.
 */
.ui-theme .unity-button:enabled:hover {
    border-top-color: var(--edge);
    border-right-color: var(--edge);
    border-bottom-color: var(--edge);
    border-left-color: var(--edge);
}

.ui-theme .unity-button:enabled:active {
    background-color: var(--surface-control-quiet);
}

/* 기본 테마의 파란 포커스 테두리가 이 팔레트에서 혼자 튄다. */
.ui-theme .unity-button:focus {
    border-top-color: var(--edge);
    border-right-color: var(--edge);
    border-bottom-color: var(--edge);
    border-left-color: var(--edge);
}

/* 스크롤바 — 화살표 버튼은 이 해상도에서 누를 일이 없어 자리만 먹는다. */
.ui-theme .unity-scroller {
    background-color: transparent;
    border-width: 0;
}

.ui-theme .unity-scroller--vertical { width: 9px; }
.ui-theme .unity-scroller--horizontal { height: 9px; }

.ui-theme .unity-scroller__low-button,
.ui-theme .unity-scroller__high-button {
    display: none;
}

.ui-theme .unity-scroller .unity-base-slider__tracker {
    background-color: var(--surface-inset);
    border-width: 0;
}

.ui-theme .unity-scroller .unity-base-slider__dragger {
    background-color: var(--edge-quiet);
    border-width: 0;
    margin: 0;
    width: 7px;
}

.ui-theme .unity-scroller .unity-base-slider__dragger:hover {
    background-color: var(--edge-soft);
}

/* 값을 고르는 슬라이더는 트랙이 보여야 어디까지 갈 수 있는지 읽힌다. */
.ui-theme .unity-slider-int .unity-base-slider__tracker {
    background-color: var(--surface-control-quiet);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--edge-quiet);
    border-right-color: var(--edge-quiet);
    border-bottom-color: var(--edge-quiet);
    border-left-color: var(--edge-quiet);
}

.ui-theme .unity-slider-int .unity-base-slider__dragger {
    background-color: var(--edge-soft);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--edge);
    border-right-color: var(--edge);
    border-bottom-color: var(--edge);
    border-left-color: var(--edge);
}

.ui-theme .unity-slider-int:disabled { opacity: 0.4; }
