  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#E7BB6B>\uBAA9\uD45C</color>\n20\uC77C \uB3D9\uC548 \uBAA8\uD5D8\uAC00\uAC00
    \uCC3E\uC544\uC624\uB294 \uB358\uC804\uC744 \uC6B4\uC601\uD558\uC138\uC694. \uCCAD\uC0B0\uC77C\uAE4C\uC9C0
    \uBE5A\uC744 \uAC1A\uC9C0 \uBABB\uD558\uBA74 \uD30C\uC0B0\uD569\uB2C8\uB2E4.\n\n<color=#E7BB6B>\uC601\uC5C5
    \uC900\uBE44</color>\n\uBC29\uC744 \uD655\uC7A5\uD558\uACE0 \uC2DC\uC124\xB7\uBAAC\uC2A4\uD130\xB7\uD568\uC815\uC744
    \uBC30\uCE58\uD558\uC138\uC694. \uC2DC\uC124\uACFC \uAE08\uACE0\uB294 \uB358\uC804
    \uB9E4\uB825\uB3C4\uB97C \uB192\uC5EC \uB354 \uB9CE\uC740 \uBC29\uBB38\uAC1D\uC744
    \uBD80\uB985\uB2C8\uB2E4.\n\n<color=#E7BB6B>\uBC29\uBB38\uAC1D \uB3D9\uC120</color>\n\uBAA8\uD5D8\uAC00\uB294
    \uAC00\uC7A5 \uC624\uB978\uCABD \uBC29\uC758 \uC911\uC559 \uBB38\uC73C\uB85C
    \uB4E4\uC5B4\uC635\uB2C8\uB2E4. \uC5EC\uAD00\xB7\uC0C1\uC810\xB7\uB300\uC7A5\uAC04\uC5D0
    \uBA38\uBB3C\uBA70 \uB3C8\uC744 \uC4F0\uACE0 \uAC15\uD574\uC9C4 \uB4A4 \uAE08\uACE0\uB97C
    \uB178\uB9BD\uB2C8\uB2E4.\n\n<color=#E7BB6B>\uC218\uC775\uACFC \uC704\uD5D8</color>\n\uBC29\uBB38\uAC1D\uB9C8\uB2E4
    \uC785\uC7A5\uB8CC\uB97C \uBC1B\uACE0 \uC2DC\uC124 \uC18C\uBE44\uAC00 \uCD94\uAC00
    \uB9E4\uCD9C\uC774 \uB429\uB2C8\uB2E4. \uC218\uC775 \uC2DC\uC124\uC744 \uC778\uC811
    \uBC30\uCE58\uD558\uBA74 \uB9E4\uCD9C\uC774 \uCD5C\uB300 40% \uB298\uC9C0\uB9CC,
    \uBC29\uBB38\uAC1D\uC774 \uB9CE\uC744\uC218\uB85D \uB9C8\uBAA8\uC640 \uC57D\uD0C8
    \uC704\uD5D8\uB3C4 \uCEE4\uC9D1\uB2C8\uB2E4.\n\n<color=#E7BB6B>\uC6B4\uC601</color>\n\uC601\uC5C5
    \uD6C4 \uB9E4\uCD9C\xB7\uAE09\uC5EC\xB7\uC720\uC9C0\uBE44\xB7\uC218\uB9AC\uBE44\uB97C
    \uD655\uC778\uD558\uACE0, \uC2DC\uC124 \uD734\uC5C5\uACFC \uC7AC\uBC30\uCE58\uB85C
    \uB2E4\uC74C \uB0A0\uC758 \uB9E4\uB825\uB3C4\uC640 \uC704\uD5D8\uC744 \uC870\uC808\uD558\uC138\uC694."
