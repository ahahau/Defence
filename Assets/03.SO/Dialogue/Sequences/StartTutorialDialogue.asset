  m_Script: {fileID: 11500000, guid: 47b6fbf626d84142a85744b0f9e1e3dc, type: 3}
  m_Name: StartTutorialDialogue
  m_EditorClassIdentifier: Assembly-CSharp::_01.Code.Dialogue.DialogueSequenceSO
  displayTitle: KEEPER'S ORDER
  lines:
  - speakerName: 임프 참모
    text: 봉인된 타일을 열어 첫 방을 만드십시오.
    enterActions: []
    choices: []
  - speakerName: 임프 참모
    text: 첫 방에 부하를 배치해 방어선을 만드십시오.
    enterActions: []
    choices: []
  - speakerName: 임프 참모
    text: 입구 포탈을 세우면 모험가 습격을 시작할 수 있습니다.
    enterActions: []
    choices: []
  - speakerName: 임프 참모
    text: 모험가를 막고 금화와 운영 보상을 회수하십시오.
    enterActions: []
    choices: []
  - speakerName: 임프 참모
    text: 모험가의 경계와 탐욕은 이동과 건물 조우마다 달라집니다.
    enterActions: []
    choices:
    - text: 지령 수행
      actions: []
      nextSequence: {fileID: 0}
      nextLineIndex: -1
      routes: []
