/*
 * 사건·튜토리얼 대화 상자. 화면 아래 가운데에 고정 크기(1120×300)로 뜬다.
 * 왼쪽에 본문, 오른쪽에 선택지(최대 셋)를 둔다. 선택지가 없으면 오른쪽 아래 "다음" 버튼.
 * 튜토리얼 강조 때는 상자 바깥을 네 조각 어둠으로 덮고 강조할 자리만 뚫는다.
 */
.dialogue-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    display: none;
}

.dialogue-root.is-open { display: flex; }

.dialogue-scrim {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: var(--color-scrim);
    display: none;
}

.dialogue-scrim.is-blocking { display: flex; }

.dialogue-spotlight {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    display: none;
}

.dialogue-spotlight.is-shown { display: flex; }
.dialogue-dim { position: absolute; background-color: var(--color-scrim); }

/* ── 상자 ── */
.dialogue-box {
    position: absolute;
    left: 50%;
    bottom: 176px;
    width: 1120px;
    height: 338px;
    translate: -50% 0;
}

.dialogue-speaker-tag {
    width: 240px;
    height: 38px;
    flex-shrink: 0;
    margin-left: 28px;
    padding: 0 14px;
    justify-content: center;
}

.dialogue-speaker { margin: 0; font-size: 15px; -unity-font-style: bold; color: var(--color-accent); }

.dialogue-card {
    flex-grow: 1;
    min-height: 0;
    padding: 18px 28px;
}

.dialogue-header { height: 30px; flex-shrink: 0; flex-direction: row; align-items: center; }
.dialogue-title { flex-grow: 1; margin: 0; font-size: 18px; -unity-font-style: bold; color: var(--color-text); }
.dialogue-progress { width: 80px; flex-shrink: 0; margin: 0 10px 0 0; font-size: 12px; -unity-text-align: middle-right; color: var(--color-text-dim); }
.dialogue-close { width: 72px; height: 28px; flex-shrink: 0; font-size: 12px; }

.dialogue-content { flex-grow: 1; min-height: 0; flex-direction: row; margin-top: 8px; }
.dialogue-body { flex-grow: 1; min-width: 0; margin: 0; font-size: 16px; white-space: normal; overflow: hidden; }

.dialogue-choices { width: 430px; flex-shrink: 0; margin-left: 18px; justify-content: flex-end; }

.dialogue-choice {
    height: 58px;
    flex-shrink: 0;
    margin-top: 8px;
    padding: 4px 14px;
    align-items: flex-start;
    justify-content: center;
    transition-property: translate, opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-cubic;
}

.dialogue-choice.is-compact { height: 38px; }
.dialogue-choice.is-entering { translate: 280px 0; opacity: 0; }
.dialogue-choice-text { margin: 0; font-size: 14px; white-space: normal; -unity-text-align: middle-left; color: var(--color-text); }
.dialogue-choice-summary { margin: 2px 0 0 0; font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; color: var(--color-text-dim); }

.dialogue-next { position: absolute; right: 28px; bottom: 18px; width: 140px; height: 40px; }
