/*
 * 오래 손대지 않았을 때 타이틀 복귀를 세는 알림. 화면 가운데 고정 크기(520×150)로 뜬다. 클릭을 막지 않는다 —
 * 아무 입력이나 들어오면 사라져야 하기 때문이다.
 */
.idle-notice-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
}

.idle-notice-root.is-shown { display: flex; }

.idle-notice-card {
    width: 520px;
    height: 150px;
    padding: 20px 40px;
    justify-content: center;
}

.idle-notice-title { height: 32px; flex-shrink: 0; margin: 0; -unity-text-align: middle-center; }
.idle-notice-text { height: 48px; flex-shrink: 0; margin: 8px 0 0 0; white-space: normal; -unity-text-align: middle-center; }
