/*
 * 반복되는 룩앤필. 화면 USS에는 배치만 두고, 모양은 여기 클래스를 조합해서 쓴다.
 * 예: <ui:Button class="btn btn--primary btn--md" />
 * 색은 DesignToken.uss의 의미값만 쓴다.
 */

/*
 * 테두리는 Super GUI 팩의 Silver(창·버튼)·Black(안쪽 칸) 조각을 이어 붙인 9-slice 그림(Skin/Silver)이다.
 * 안쪽은 비워 뒀으니 바탕색은 토큰이 정한다. 변의 무늬는 늘이면 뭉개져서 반복(tiled)으로 깐다.
 * 그림 테두리가 선 테두리를 대신하므로 border-width는 0이다. 상태는 그림에 곱하는 색으로 보인다.
 * 큰 모달 창(.panel--window)만 오른쪽 위·왼쪽 아래가 잘린 그림이 바탕까지 칠한다.
 */

/* ── 버튼 ── */
.btn {
    margin: 0;
    padding: 0 10px;
    border-width: 0;
    border-radius: 0;
    background-color: var(--color-control);
    background-image: url("project://database/Assets/GameModules/UI/Skin/Silver/ButtonFrame.png");
    -unity-slice-left: 9;
    -unity-slice-right: 9;
    -unity-slice-top: 9;
    -unity-slice-bottom: 9;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: var(--color-skin-frame);
    color: var(--color-text-body);
    font-size: 14px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.btn:enabled:hover { -unity-background-image-tint-color: var(--color-skin-frame-hover); color: var(--color-accent-soft); }
.btn:enabled:active { background-color: var(--color-control-pressed); -unity-background-image-tint-color: var(--color-skin-frame-pressed); }
.btn:disabled { opacity: 0.45; }

.btn--primary { background-color: var(--color-primary); color: var(--color-text); -unity-font-style: bold; }
.btn--secondary { background-color: var(--color-control); }
.btn--danger { -unity-background-image-tint-color: var(--color-skin-frame-danger); color: var(--color-loss); }

/* 크기는 가장 긴 문구 기준 고정 폭이다. 문구가 바뀌어도 줄이 흔들리지 않는다. */
.btn--md { width: 136px; height: 36px; flex-shrink: 0; }
.btn--lg { width: 200px; height: 44px; flex-shrink: 0; font-size: 16px; }

/* ── 패널 ── */
.panel {
    background-color: var(--color-surface);
    border-width: 0;
    background-image: url("project://database/Assets/GameModules/UI/Skin/Silver/PanelFrame.png");
    -unity-slice-left: 10;
    -unity-slice-right: 10;
    -unity-slice-top: 10;
    -unity-slice-bottom: 10;
    /* 큰 창은 그림을 두 배로 깐다. 원래 크기면 모서리 장식이 실선처럼 뭉개진다. */
    -unity-slice-scale: 2px;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: var(--color-skin-frame);
}

/* 큰 모달 창. 모서리가 잘린 그림이 바탕까지 칠하므로 요소 바탕은 비운다. */
.panel--window {
    background-color: var(--color-skin-window-fill);
    background-image: url("project://database/Assets/GameModules/UI/Skin/Silver/WindowFrame.png");
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
}

.panel--inset {
    background-color: var(--color-surface-inset);
    border-width: 0;
    background-image: url("project://database/Assets/GameModules/UI/Skin/Silver/BoxFrame.png");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: var(--color-skin-frame);
}

/* 화면 전체를 덮는 모달 바탕. 아래 UI 클릭을 막는다. */
.scrim {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: var(--color-scrim);
    align-items: center;
    justify-content: center;
}

/* ── 글자 ── */
.text-title { color: var(--color-accent); font-size: 20px; -unity-font-style: bold; }
.text-body { color: var(--color-text-body); font-size: 14px; white-space: normal; }
.text-dim { color: var(--color-text-dim); font-size: 12px; }
.text-warn { color: var(--color-warn); }
.text-loss { color: var(--color-loss); }
.text-gain { color: var(--color-gain); }

/* 한 줄을 넘으면 자른다. 전체 문구는 툴팁으로 보여 준다. */
.text-ellipsis { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
