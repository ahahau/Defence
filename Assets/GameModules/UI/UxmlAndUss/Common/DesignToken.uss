/*
 * 색 토큰. 다른 USS는 여기 정의된 의미값(semantic)만 var()로 참조한다.
 *
 * 1단계 원시값(팔레트)은 Super GUI 팩의 Silver(남색 창)·Black(회색 칸) 조각에서 뽑았다.
 * 옛 화면의 Theme.uss도 같은 값을 쓴다. 두 화면이 한동안 같이 뜨므로 팔레트가 같아야 한 게임처럼 보인다.
 * 수입 초록·지출 빨강·경고 호박색처럼 뜻이 있는 색은 예전 값을 그대로 둔다.
 *
 * 변수는 상속되므로 문서의 가장 바깥 요소에 `ui-theme` 클래스를 붙인다.
 * 여러 UIDocument가 한 패널을 공유해 루트가 문서마다 달라서 :root에 의존하지 않는다.
 */
.ui-theme {
    /* ── 1단계: 팔레트 ── */
    --color-night-950-a86: rgba(20, 19, 33, 0.86);
    --color-night-900: rgb(33, 32, 52);
    --color-ink-800: rgb(51, 50, 61);
    --color-slate-700: rgb(80, 83, 109);
    --color-slate-600: rgb(77, 83, 120);
    --color-slate-500: rgb(110, 115, 149);
    --color-slate-300: rgb(137, 142, 180);
    --color-slate-200: rgb(169, 174, 218);
    --color-steel-600: rgb(75, 77, 78);
    --color-steel-500: rgb(92, 97, 101);
    --color-steel-300: rgb(130, 133, 135);
    --color-silver-200: rgb(177, 192, 204);
    --color-silver-100: rgb(216, 220, 234);
    --color-white-50: rgb(246, 246, 246);
    --color-gold-400: rgb(255, 194, 79);
    --color-gold-200: rgb(242, 212, 148);
    --color-green-300: rgb(138, 230, 145);
    --color-salmon-300: rgb(255, 161, 138);
    --color-amber-400: rgb(224, 176, 112);
    --color-red-600: rgb(230, 71, 41);
    --color-white: rgb(255, 255, 255);
    --color-none: rgba(0, 0, 0, 0);

    /* ── 2단계: 의미값 ── */
    --color-scrim: var(--color-night-950-a86);
    --color-surface: var(--color-slate-600);
    --color-surface-inset: var(--color-steel-600);
    --color-control: var(--color-slate-700);
    --color-control-pressed: var(--color-ink-800);

    --color-border: var(--color-silver-200);
    --color-border-soft: var(--color-slate-300);
    --color-border-quiet: var(--color-steel-500);

    --color-text: var(--color-white-50);
    --color-text-body: var(--color-silver-100);
    --color-text-dim: var(--color-slate-200);
    --color-accent: var(--color-gold-400);
    --color-accent-soft: var(--color-gold-200);

    --color-gain: var(--color-green-300);
    --color-loss: var(--color-salmon-300);
    --color-warn: var(--color-amber-400);
    --color-danger: var(--color-red-600);

    --color-primary: var(--color-slate-500);
    --color-primary-border: var(--color-silver-200);

    /* 테두리 이미지(Skin/Silver)에 곱하는 색. 흰색이면 그림 그대로다. */
    --color-skin-frame: var(--color-white);
    --color-skin-frame-hover: var(--color-gold-200);
    --color-skin-frame-pressed: var(--color-slate-300);
    --color-skin-frame-selected: var(--color-gold-400);
    --color-skin-frame-danger: var(--color-red-600);
    /* 잘린 모서리 창은 그림이 바탕까지 칠한다. 요소 바탕을 비워야 모서리 밖이 칠해지지 않는다. */
    --color-skin-window-fill: var(--color-none);
}
