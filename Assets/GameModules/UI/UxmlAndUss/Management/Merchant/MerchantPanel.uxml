<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/GameModules/UI/UxmlAndUss/Common/DesignToken.uss" />
    <Style src="project://database/Assets/GameModules/UI/UxmlAndUss/Common/Components.uss" />
    <Style src="project://database/Assets/GameModules/UI/UxmlAndUss/Management/Merchant/MerchantPanel.uss" />
    <ui:VisualElement name="merchant-root" class="ui-theme scrim merchant-root">
        <ui:VisualElement name="merchant-card" class="panel panel--window merchant-card">
            <ui:VisualElement class="merchant-header">
                <ui:Label name="merchant-title" text="떠돌이 상인" class="text-title merchant-title" />
                <ui:Label name="merchant-visit" text="1일차 · 다음 방문 3일차" class="text-dim text-ellipsis merchant-visit" />
                <ui:Button name="merchant-close" text="닫기" class="btn btn--secondary merchant-close" />
            </ui:VisualElement>
            <ui:VisualElement name="merchant-offers" class="merchant-offers" />
            <ui:Label name="merchant-detail" text="유물을 고르면 즉시 구매합니다." class="text-body merchant-detail" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
