<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/GameModules/UI/UxmlAndUss/Common/DesignToken.uss" />
    <Style src="project://database/Assets/GameModules/UI/UxmlAndUss/Common/Components.uss" />
    <Style src="project://database/Assets/GameModules/UI/UxmlAndUss/Battle/WaveHud/WaveHud.uss" />
    <ui:VisualElement name="wave-hud-root" class="ui-theme wave-hud-root" picking-mode="Ignore">
        <ui:VisualElement name="wave-prep-card" class="panel wave-prep-card" picking-mode="Ignore">
            <ui:Label name="wave-prep-title" text="DAY 1 · 영업 준비" class="text-title text-ellipsis wave-prep-title" picking-mode="Ignore" />
            <ui:Label name="wave-prep-body" text="" class="text-body wave-prep-body" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="wave-progress-card" class="panel wave-progress-card" picking-mode="Ignore">
            <ui:Label name="wave-progress-title" text="던전 영업 중" class="text-title text-ellipsis wave-progress-title" picking-mode="Ignore" />
            <ui:VisualElement class="panel--inset wave-progress-track" picking-mode="Ignore">
                <ui:VisualElement name="wave-progress-fill" class="wave-progress-fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="wave-progress-stats" text="" class="text-body wave-progress-stats" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="wave-banner" class="panel panel--window wave-banner" picking-mode="Ignore">
            <ui:Label name="wave-banner-title" text="" class="text-title text-ellipsis wave-banner-title" picking-mode="Ignore" />
            <ui:Label name="wave-banner-subtitle" text="" class="text-body text-ellipsis wave-banner-subtitle" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="wave-actions" picking-mode="Ignore">
            <ui:Button name="wave-objective-button" text="목표" class="btn wave-objective-button" />
            <ui:Button name="wave-start-button" class="btn btn--primary wave-start-button">
                <ui:Label name="wave-start-label" text="던전 영업 시작" class="wave-start-label" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
