/*
 * 영업(웨이브) HUD. 대기 중에는 위쪽 가운데 준비 카드와 오른쪽 아래 시작 버튼이, 영업 중에는 같은 자리에
 * 진행 막대가 뜬다. 영업이 시작되면 가운데 배너가 잠깐 떴다 사라진다.
 * 상단 바(92)·오른쪽 기록판(폭 292 + 여백)·하단 바(148)를 피해서 지도 위에 둔다. 크기는 모두 고정이다(ui-rules 10번).
 */
.wave-hud-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* ── 준비 카드 ── */
.wave-prep-card {
    position: absolute;
    top: 104px;
    left: 50%;
    width: 660px;
    height: 236px;
    translate: -50% 0;
    padding: 16px 22px;
}

.wave-prep-title { height: 30px; flex-shrink: 0; margin: 0; -unity-text-align: middle-center; }
.wave-prep-body { flex-grow: 1; min-height: 0; margin: 6px 0 0 0; overflow: hidden; font-size: 13px; -unity-text-align: upper-center; }

/* ── 진행 막대 ── */
.wave-progress-card {
    position: absolute;
    top: 104px;
    left: 50%;
    width: 620px;
    height: 118px;
    translate: -50% 0;
    padding: 12px 22px;
}

.wave-progress-title { height: 26px; flex-shrink: 0; margin: 0; font-size: 18px; -unity-text-align: middle-left; }
.wave-progress-track { height: 16px; flex-shrink: 0; margin: 4px 0; padding: 3px; }
.wave-progress-fill { height: 100%; width: 0; background-color: var(--color-danger); }
.wave-progress-fill.is-boss { background-color: var(--color-accent); }
.wave-progress-stats { height: 34px; flex-shrink: 0; margin: 0; font-size: 12px; overflow: hidden; -unity-text-align: middle-left; }

/* ── 영업 시작 배너 ── */
.wave-banner {
    position: absolute;
    top: 360px;
    left: 50%;
    width: 640px;
    height: 120px;
    translate: -50% 0;
    padding: 18px 40px;
    justify-content: center;
    display: none;
}

.wave-banner.is-shown { display: flex; }
.wave-banner-title { height: 40px; flex-shrink: 0; margin: 0; font-size: 28px; -unity-text-align: middle-center; }
.wave-banner-subtitle { height: 24px; flex-shrink: 0; margin: 4px 0 0 0; -unity-text-align: middle-center; }

/* ── 시작 버튼 ── */
.wave-actions {
    position: absolute;
    right: 326px;
    bottom: 178px;
    width: 320px;
    align-items: stretch;
}

.wave-objective-button { height: 40px; flex-shrink: 0; margin-bottom: 8px; font-size: 13px; }
.wave-start-button { height: 68px; flex-shrink: 0; }
.wave-start-label { margin: 0; font-size: 17px; white-space: normal; -unity-text-align: middle-center; -unity-font-style: bold; color: var(--color-text); }

/* 튜토리얼이 비출 때 그림 테두리를 금색으로 물들인다. */
.wave-start-button.is-highlighted { -unity-background-image-tint-color: var(--color-skin-frame-selected); }
