<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/GameModules/UI/UxmlAndUss/Common/DesignToken.uss" />
    <Style src="project://database/Assets/GameModules/UI/UxmlAndUss/Common/Components.uss" />
    <Style src="project://database/Assets/GameModules/UI/UxmlAndUss/Battle/UnitStatus/UnitStatusPanel.uss" />
    <ui:VisualElement name="unit-status-root" class="ui-theme unit-status-root" picking-mode="Ignore">
        <ui:VisualElement name="unit-status-card" class="panel unit-status-card">
            <ui:VisualElement class="unit-status-header">
                <ui:Label name="unit-status-title" text="부하 Lv 1" class="text-title text-ellipsis unit-status-title" />
                <ui:Button name="unit-status-close" text="닫기" class="btn btn--secondary unit-status-close" />
            </ui:VisualElement>
            <ui:Label name="unit-status-state" text="상태" class="text-dim unit-status-line" />
            <ui:VisualElement class="unit-status-body">
                <ui:VisualElement name="unit-status-portrait" class="panel--inset unit-status-portrait" />
                <ui:VisualElement class="unit-status-stats">
                    <ui:Label name="unit-status-hp" text="HP 0/0" class="text-body unit-status-line" />
                    <ui:VisualElement class="unit-status-bar">
                        <ui:VisualElement name="unit-status-hp-fill" class="unit-status-bar-fill unit-status-bar-fill--hp" />
                    </ui:VisualElement>
                    <ui:Label name="unit-status-combat" text="ATK 0" class="text-body unit-status-line" />
                    <ui:Label name="unit-status-command" text="명령" class="text-body unit-status-line" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="unit-status-traits" text="특성 · 성격" class="text-body unit-status-line" />
            <ui:Label name="unit-status-fatigue" text="피로 0/100" class="text-body unit-status-line" />
            <ui:VisualElement class="unit-status-bar">
                <ui:VisualElement name="unit-status-fatigue-fill" class="unit-status-bar-fill fatigue--ok" />
            </ui:VisualElement>
            <ui:Label name="unit-status-hint" text="안내" class="text-warn unit-status-line unit-status-hint" />
            <ui:VisualElement class="unit-status-actions">
                <ui:Button name="unit-status-recover" text="치료·휴식" class="btn btn--primary unit-status-action" />
                <ui:Button name="unit-status-recall" text="회수(대기 명단)" class="btn btn--secondary unit-status-action" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="unit-status-tooltip" class="panel unit-status-tooltip" picking-mode="Ignore">
            <ui:Label name="unit-status-tooltip-text" text="특성 설명" class="text-body unit-status-tooltip-text" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
