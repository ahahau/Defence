<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/GameModules/UI/UxmlAndUss/Common/DesignToken.uss" />
    <Style src="project://database/Assets/GameModules/UI/UxmlAndUss/Common/Components.uss" />
    <Style src="project://database/Assets/GameModules/UI/UxmlAndUss/Battle/Artifacts/ArtifactBar.uss" />
    <ui:VisualElement name="artifact-root" class="ui-theme artifact-root" picking-mode="Ignore">
        <ui:VisualElement name="artifact-bar" class="panel--inset artifact-bar">
            <ui:Label text="유물" class="text-dim artifact-bar-label" />
            <ui:VisualElement name="artifact-icons" class="artifact-icons" />
        </ui:VisualElement>
        <ui:VisualElement name="artifact-tooltip" class="panel artifact-tooltip" picking-mode="Ignore">
            <ui:Label name="artifact-tooltip-name" text="유물" class="text-title text-ellipsis artifact-tooltip-name" picking-mode="Ignore" />
            <ui:Label name="artifact-tooltip-description" text="설명" class="text-body artifact-tooltip-description" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
