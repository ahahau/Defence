/*
 * 보스 습격 배너. 화면 위쪽 가운데에 잠깐 미끄러져 들어왔다 사라진다. 클릭을 막지 않는다.
 * 크기는 고정(720×104), 긴 문구는 자른다(ui-rules 10번).
 */
.boss-banner-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    padding-top: 140px;
}

.boss-banner-card {
    width: 720px;
    height: 104px;
    padding: 14px 24px;
    justify-content: center;
    opacity: 0;
    translate: -80px 0;
    transition-property: opacity, translate;
    transition-duration: 0.3s, 0.35s;
    transition-timing-function: ease-out, ease-out-cubic;
}

.boss-banner-card--shown { opacity: 1; translate: 0 0; }
.boss-banner-card--leaving { opacity: 0; translate: 0 0; transition-duration: 0.4s, 0s; }

.boss-banner-title { height: 44px; flex-shrink: 0; margin: 0; font-size: 30px; -unity-font-style: bold; -unity-text-align: middle-center; color: var(--color-danger); }
.boss-banner-title--final { color: var(--color-accent); }
.boss-banner-subtitle { height: 26px; flex-shrink: 0; margin: 4px 0 0 0; -unity-text-align: middle-center; }
