/*
 * 모험가 상태 패널 배치. 누른 자리 옆에 뜨는 고정 크기 카드다(ui-rules 10번).
 * 고정 영역: 헤더 36 · 상태 20 · 수치 6줄 144 · 상태이상 제목 20 · 상태이상 4줄 80.
 * 상태이상이 없어도 자리를 지킨다(visibility로만 숨긴다).
 */
.enemy-status-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.enemy-status-card {
    position: absolute;
    width: 400px;
    height: 360px;
    padding: 12px 14px;
}

.enemy-status-header { height: 36px; flex-shrink: 0; flex-direction: row; align-items: center; }
.enemy-status-title { flex-grow: 1; min-width: 0; -unity-text-align: middle-left; }
.enemy-status-close { width: 64px; height: 28px; flex-shrink: 0; }

.enemy-status-line {
    height: 20px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.enemy-status-stats { height: 144px; flex-shrink: 0; padding: 6px 10px; margin: 4px 0; justify-content: space-between; }
.enemy-status-effects { height: 80px; flex-shrink: 0; }
