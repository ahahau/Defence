/*
 * 방 관리 화면. HUD(공용 패널, 문서 순서 100) 위에 같은 패널로 뜬다(문서 순서 150).
 * uGUI 튜토리얼 덮개보다 아래에 있어야 덮개가 버튼을 가리고 구멍만 눌린다.
 * 모든 영역은 고정 크기다(ui-rules 10번). 조건부 요소는 visibility로만 숨겨 자리를 지킨다.
 *
 * 방 상세(오른쪽 400×640): 헤더 36 · 상태 20 · 시설(제목 20 · 이름 20 · 막대 8 · 상태 20 · 이용 20 · 버튼 36)
 *   · 유닛(제목 줄 28 · 유닛 4줄 120 · 명령 34 · 이동/회수 34) · 설치물(제목 20 · 줄 20) · 안내 2줄(남는 높이).
 * 설치 창(하단 행동 바 위 760×360): 헤더 36 · 카드 줄 150(120×150 카드 5장) · 상세 130.
 *   위치를 고르는 동안은 헤더만 남긴 접힌 모양(52)이 된다.
 */
.room-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* ── 방 상세 ── */
.room-detail {
    position: absolute;
    top: 106px;
    right: 18px;
    width: 400px;
    height: 640px;
    padding: 12px 14px;
    display: none;
}

.room-header { height: 36px; flex-shrink: 0; flex-direction: row; align-items: center; }
.room-title { flex-grow: 1; min-width: 0; margin: 0; -unity-text-align: middle-left; font-size: 18px; }
.room-close { width: 64px; height: 28px; flex-shrink: 0; }

.room-line {
    height: 20px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.room-divider { height: 1px; flex-shrink: 0; margin: 4px 0; background-color: var(--color-border-quiet); }
.room-section-title { height: 20px; flex-shrink: 0; margin: 0; padding: 0; color: var(--color-accent-soft); font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-left; }
.room-section-row { height: 28px; flex-shrink: 0; flex-direction: row; align-items: center; }
.room-unit-count { flex-grow: 1; }
.room-deploy { width: 80px; height: 26px; flex-shrink: 0; }

.room-bar { height: 8px; flex-shrink: 0; margin: 2px 0; background-color: var(--color-surface-inset); border-width: 1px; border-color: var(--color-border-quiet); }
.room-bar-fill { height: 100%; width: 0; background-color: var(--color-gain); }
.room-bar-fill--worn { background-color: var(--color-warn); }
.room-bar-fill--broken { background-color: var(--color-loss); }

.room-actions { height: 36px; flex-shrink: 0; flex-direction: row; justify-content: space-between; align-items: center; margin-top: 2px; }
.room-action { width: 120px; height: 32px; flex-shrink: 0; font-size: 13px; }

.room-unit-list { height: 120px; flex-shrink: 0; }
.room-unit-row {
    height: 28px;
    flex-shrink: 0;
    margin: 0 0 2px 0;
    padding: 0 8px;
    -unity-text-align: middle-left;
    font-size: 12px;
}
.room-unit-row.is-selected { border-color: var(--color-border); -unity-background-image-tint-color: var(--color-skin-frame-selected); color: var(--color-accent); background-color: var(--color-control-pressed); }

.room-unit-commands { height: 34px; flex-shrink: 0; flex-direction: row; justify-content: space-between; align-items: center; }
.room-command { width: 88px; height: 30px; flex-shrink: 0; font-size: 12px; padding: 0 4px; }
.room-unit-moves { height: 34px; flex-shrink: 0; flex-direction: row; align-items: center; }
.room-unit-move { width: 120px; height: 30px; flex-shrink: 0; margin-right: 8px; }
.room-unit-recall { width: 120px; height: 30px; flex-shrink: 0; }

/* 안내 줄은 남는 높이를 쓰고 두 줄까지 보인다. */
.room-hint { flex-grow: 1; min-height: 0; margin: 4px 0 0 0; padding: 0; font-size: 12px; white-space: normal; overflow: hidden; -unity-text-align: lower-left; }

/* ── 설치 창 ── */
.install-card {
    position: absolute;
    left: 18px;
    bottom: 166px;
    width: 760px;
    height: 360px;
    padding: 10px 12px;
    display: none;
}

.install-card--collapsed { height: 60px; }
.install-card--collapsed .install-body { display: none; }
.install-card--collapsed .install-page,
.install-card--collapsed .install-page-label { visibility: hidden; }

.install-header { height: 36px; flex-shrink: 0; flex-direction: row; align-items: center; }
.install-title { width: 120px; flex-shrink: 0; margin: 0; -unity-text-align: middle-left; font-size: 18px; }
.install-subtitle { flex-grow: 1; min-width: 0; margin: 0 8px 0 0; -unity-text-align: middle-left; }
.install-page { width: 52px; height: 28px; flex-shrink: 0; }
.install-page-label { width: 56px; flex-shrink: 0; margin: 0; -unity-text-align: middle-center; }
.install-close { width: 64px; height: 28px; flex-shrink: 0; margin-left: 12px; }

.install-body { flex-grow: 1; min-height: 0; }
.install-tiles { height: 150px; flex-shrink: 0; flex-direction: row; margin-top: 4px; }
/* 빈 갈래 문구는 카드 줄과 같은 자리를 쓰므로 카드 줄 위에 겹쳐 둔다. */
.install-empty { position: absolute; top: 4px; left: 0; right: 0; height: 150px; margin: 0; -unity-text-align: middle-center; visibility: hidden; }

.install-tile {
    width: 136px;
    height: 150px;
    flex-shrink: 0;
    margin-right: 8px;
    padding: 6px;
    align-items: stretch;
    justify-content: flex-start;
}
.install-tile.is-selected { border-color: var(--color-accent); border-width: 2px; background-color: var(--color-control-pressed); }
.install-tile--blocked { opacity: 0.55; }
.install-tile-icon { width: 64px; height: 64px; flex-shrink: 0; align-self: center; -unity-background-scale-mode: scale-to-fit; }
.install-tile-name { height: 20px; flex-shrink: 0; margin: 4px 0 0 0; font-size: 13px; -unity-font-style: bold; color: var(--color-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-center; }
.install-tile-price { height: 18px; flex-shrink: 0; margin: 2px 0 0 0; font-size: 12px; color: var(--color-accent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-center; }
.install-tile-note { height: 18px; flex-shrink: 0; margin: 2px 0 0 0; font-size: 11px; color: var(--color-text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-center; }
.install-tile-note.text-loss { color: var(--color-loss); }

.install-detail { height: 130px; flex-shrink: 0; flex-direction: row; }
.install-detail-text { flex-grow: 1; min-width: 0; margin-right: 12px; }
.install-detail-name { height: 24px; flex-shrink: 0; margin: 0; font-size: 15px; -unity-font-style: bold; -unity-text-align: middle-left; }
.install-detail-line { height: 20px; flex-shrink: 0; margin: 0; -unity-text-align: middle-left; }
.install-detail-effect { height: 54px; flex-shrink: 0; margin: 2px 0; white-space: normal; overflow: hidden; -unity-text-align: upper-left; }
.install-confirm { align-self: flex-end; margin-bottom: 4px; }
