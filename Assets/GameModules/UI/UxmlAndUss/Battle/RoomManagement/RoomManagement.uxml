<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/GameModules/UI/UxmlAndUss/Common/DesignToken.uss" />
    <Style src="project://database/Assets/GameModules/UI/UxmlAndUss/Common/Components.uss" />
    <Style src="project://database/Assets/GameModules/UI/UxmlAndUss/Battle/RoomManagement/RoomManagement.uss" />
    <ui:VisualElement name="room-root" class="ui-theme room-root" picking-mode="Ignore">
        <ui:VisualElement name="room-detail" class="panel room-detail">
            <ui:VisualElement class="room-header">
                <ui:Label name="room-title" text="통로 · 중형" class="text-title text-ellipsis room-title" />
                <ui:Button name="room-close" text="닫기" class="btn btn--secondary room-close" />
            </ui:VisualElement>
            <ui:Label name="room-state" text="일반 방" class="text-dim room-line" />
            <ui:VisualElement class="room-divider" />
            <ui:Label text="시설" class="room-section-title" />
            <ui:Label name="room-facility-name" text="시설 없음" class="text-body room-line" />
            <ui:VisualElement name="room-facility-bar" class="room-bar">
                <ui:VisualElement name="room-facility-bar-fill" class="room-bar-fill" />
            </ui:VisualElement>
            <ui:Label name="room-facility-status" text="" class="text-body room-line" />
            <ui:Label name="room-facility-usage" text="" class="text-dim room-line" />
            <ui:VisualElement class="room-actions">
                <ui:Button name="room-repair" text="수리" class="btn btn--secondary room-action" />
                <ui:Button name="room-closure" text="휴업" class="btn btn--secondary room-action" />
                <ui:Button name="room-demolish" text="철거" class="btn btn--danger room-action" />
            </ui:VisualElement>
            <ui:VisualElement class="room-divider" />
            <ui:VisualElement class="room-section-row">
                <ui:Label name="room-unit-count" text="유닛 0 / 0" class="room-section-title room-unit-count" />
                <ui:Button name="room-deploy" text="배치" class="btn btn--primary room-deploy" />
            </ui:VisualElement>
            <ui:VisualElement name="room-unit-list" class="room-unit-list" />
            <ui:VisualElement name="room-unit-commands" class="room-unit-commands" />
            <ui:VisualElement class="room-unit-moves">
                <ui:Button name="room-unit-move" text="이동" class="btn btn--secondary room-unit-move" />
                <ui:Button name="room-unit-recall" text="회수" class="btn btn--secondary room-unit-recall" />
            </ui:VisualElement>
            <ui:VisualElement class="room-divider" />
            <ui:Label text="설치물" class="room-section-title" />
            <ui:Label name="room-installations" text="없음" class="text-body room-line" />
            <ui:Label name="room-rumor" text="소문 없음" class="text-body room-line" />
            <ui:Label name="room-hint" text="일시정지하면 관리할 수 있습니다." class="text-warn room-hint" />
        </ui:VisualElement>
        <ui:VisualElement name="install-card" class="panel install-card">
            <ui:VisualElement class="install-header">
                <ui:Label name="install-title" text="건설" class="text-title install-title" />
                <ui:Label name="install-subtitle" text="" class="text-dim text-ellipsis install-subtitle" />
                <ui:Button name="install-prev" text="이전" class="btn btn--secondary install-page" />
                <ui:Label name="install-page" text="1 / 1" class="text-dim install-page-label" />
                <ui:Button name="install-next" text="다음" class="btn btn--secondary install-page" />
                <ui:Button name="install-close" text="닫기" class="btn btn--secondary install-close" />
            </ui:VisualElement>
            <ui:VisualElement name="install-body" class="install-body">
                <ui:VisualElement name="install-tiles" class="install-tiles" />
                <ui:Label name="install-empty" text="이 갈래에 고를 것이 없습니다." class="text-dim install-empty" />
                <ui:VisualElement class="room-divider" />
                <ui:VisualElement class="install-detail">
                    <ui:VisualElement class="install-detail-text">
                        <ui:Label name="install-detail-name" text="" class="text-body text-ellipsis install-detail-name" />
                        <ui:Label name="install-detail-summary" text="" class="text-body text-ellipsis install-detail-line" />
                        <ui:Label name="install-detail-effect" text="" class="text-dim install-detail-effect" />
                        <ui:Label name="install-detail-reason" text="" class="text-loss text-ellipsis install-detail-line" />
                    </ui:VisualElement>
                    <ui:Button name="install-confirm" text="설치" class="btn btn--primary btn--md install-confirm" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
