  displayTitle: "\uD3D0\uC790\uC7AC \uACBD\uB9E4"
  lines:
  - speakerName: "\uC784\uD504 \uCC38\uBAA8"
    text: "\uC8FC\uC778\uB2D8, \uD3D0\uC790\uC7AC\uB97C \uC0AC\uACA0\uB2E4\uB294 \uC0C1\uC778\uC774 \uC654\uC2B5\uB2C8\uB2E4.\n\uAC00\uB3D9 \uC2DC\uC124\uC758 \uBD80\uD488\uAE4C\uC9C0 \uB0B4\uB193\uC73C\uBA74 \uAC12\uC744 \uB354 \uCCD0\uC900\uB2F5\uB2C8\uB2E4."
    enterActions: []
    choices:
    - text: "\uAC00\uB3D9 \uC2DC\uC124\uC758 \uBD80\uD488\uAE4C\uC9C0 \uCC98\uBD84\uD55C\uB2E4"
      effectSummary: "\uAE08\uD654 +35 / \uBAA8\uB4E0 \uC218\uC775 \uC2DC\uC124 \uB0B4\uAD6C\uB3C4 -3"
      actions:
      - {fileID: 11400000, guid: ea088b6deb1d40de90a45f47cd653610, type: 2}
      - {fileID: 11400000, guid: bfa0ae4d6ac34dc46829b001a9f4fb83, type: 2}
      nextSequence: {fileID: 5775042272720818558}
      nextLineIndex: 0
      routes: []
    - text: "\uD3D0\uC790\uC7AC\uB97C \uBD80\uD558\uB4E4\uC5D0\uAC8C \uB098\uB220 \uC900\uB2E4"
