  lines:
  - speakerName: "\uC784\uD504 \uCC38\uBAA8"
    text: "\uC784\uD504\uB4E4\uC740 \uC790\uAE30 \uC190\uC73C\uB85C \uB9C8\uB828\uD55C \uBB3C\uC790\uB97C \uB2E4\uC2DC \uBC1B\uC558\uC2B5\uB2C8\uB2E4.\n\uB2E4\uC74C \uC791\uC5C5\uB3C4 \uD568\uAED8\uD558\uC790\uBA70 \uACF5\uAD6C\uD568\uC744 \uB458\uB7EC\uBA54\uB294\uAD70\uC694."
