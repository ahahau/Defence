  m_EditorClassIdentifier: DungeonKeeper.Runtime::Code.Dialogue.DialogueSequenceSO
  displayTitle: "\uC791\uC5C5\uBC18\uC758 \uB2F5\uB840"
  lines:
  - speakerName: "\uC784\uD504 \uCC38\uBAA8"
    text: "\uC8FC\uC778\uB2D8, \uACF5\uAD6C\uB97C \uB9C8\uB828\uD574 \uC900 \uC791\uC5C5\uBC18\uC774 \uB2F5\uB840\uB97C \uAC00\uC838\uC654\uC2B5\uB2C8\uB2E4.\n\uB0A8\uC740 \uBB3C\uC790\uB97C \uD314 \uC218\uB3C4, \uC791\uC5C5\uBC18\uC5D0 \uB3CC\uB824\uC904 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
    enterActions: []
    choices:
    - text: "\uB2F5\uB840 \uBB3C\uC790\uB97C \uD314\uC544 \uAE08\uACE0\uC5D0 \uBCF4\uD0E0\uB2E4"
      effectSummary: "\uAE08\uD654 +35"
      actions:
      - {fileID: 11400000, guid: ea088b6deb1d40de90a45f47cd653610, type: 2}
      nextSequence: {fileID: 3989166323696058071}
      nextLineIndex: 0
      routes: []
    - text: "\uBB3C\uC790\uB97C \uC791\uC5C5\uBC18\uC5D0 \uB3CC\uB824\uC900\uB2E4"
      effectSummary: "\uBBFC\uC2EC +4"
