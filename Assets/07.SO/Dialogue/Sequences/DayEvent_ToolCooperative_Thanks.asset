  displayTitle: "\uC791\uC5C5\uBC18\uC758 \uB2F5\uB840"
  lines:
  - speakerName: "\uC784\uD504 \uCC38\uBAA8"
    text: "\uB2F5\uB840 \uBB3C\uC790\uAC00 \uAE08\uD654\uB85C \uBC14\uB00C\uC5B4 \uAE08\uACE0\uC5D0 \uB4E4\uC5B4\uC654\uC2B5\uB2C8\uB2E4.\n\uC791\uC5C5\uBC18\uC7A5\uC740 \uC57D\uC18D\uC744 \uC9C0\uCF30\uB2E4\uBA70 \uD759 \uBB3B\uC740 \uC190\uC744 \uB0B4\uBC00\uC5C8\uC2B5\uB2C8\uB2E4."
    enterActions: []
    choices: []
  metaProgressRequired: 0
  followUps: []
