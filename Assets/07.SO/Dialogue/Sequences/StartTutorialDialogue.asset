  m_Script: {fileID: 11500000, guid: 47b6fbf626d84142a85744b0f9e1e3dc, type: 3}
  m_Name: StartTutorialDialogue
  m_EditorClassIdentifier: DungeonKeeper.Runtime::Code.Dialogue.DialogueSequenceSO
  displayTitle: 던전의 첫 밤
  lines:
  - speakerName: 임프 참모
    text: 던전의 주인이 쓰러지기 전에 스무 밤을 버티십시오. 부채 한도를 넘겨도 던전은 끝입니다.
    enterActions: []
    choices: []
  - speakerName: 임프 참모
    text: 방을 넓히고 부하를 고용해 길목에 배치하십시오. 포탈을 세우면 적의 습격을 시작할 수 있습니다.
    enterActions: []
    choices: []
  - speakerName: 임프 참모
    text: 전투는 자동입니다. 습격 뒤 보상과 시설 수입에서 유지비와 이자가 빠지니, 첫날부터 금화를 전부 쓰지는 마십시오.
    enterActions: []
    choices: []
  - speakerName: 임프 참모
    text: 화면 위 안내가 첫 전투와 정산까지 하나씩 짚어 드립니다. 막히면 설정의 게임 안내를 다시 보십시오.
    enterActions: []
    choices:
    - text: 시작하지
      actions: []
      nextSequence: {fileID: 0}
      nextLineIndex: -1
      routes: []
