  displayTitle: "\uBC24\uC0D8 \uC791\uC5C5\uBC18\uC758 \uC694\uCCAD"
  lines:
  - speakerName: "\uC784\uD504 \uCC38\uBAA8"
    text: "\uBC24\uC0D8\uC744 \uB9C8\uCE5C \uBD80\uD558\uB4E4\uC774 \uB530\uB73B\uD55C \uC2DD\uC0AC \uC55E\uC5D0 \uC549\uC558\uC2B5\uB2C8\uB2E4.\n\uBE48 \uADF8\uB987\uC774 \uC313\uC77C\uC218\uB85D \uAD73\uC5C8\uB358 \uD45C\uC815\uB3C4 \uC870\uAE08\uC529 \uD480\uB9BD\uB2C8\uB2E4."
