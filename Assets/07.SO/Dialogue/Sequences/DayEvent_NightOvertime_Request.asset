  displayTitle: "\uBC24\uC0D8 \uC791\uC5C5\uBC18\uC758 \uC694\uCCAD"
  lines:
  - speakerName: "\uC784\uD504 \uCC38\uBAA8"
    text: "\uCD94\uAC00 \uBB3C\uC790\uB97C \uB118\uAE30\uACE0 \uC57D\uC18D\uD55C \uAE08\uD654\uB97C \uBC1B\uC558\uC2B5\uB2C8\uB2E4.\n\uBD80\uD558\uB4E4\uC740 \uC26C\uC790\uB294 \uB9D0\uC744 \uC0BC\uD0A8 \uCC44 \uB2E4\uC2DC \uCC3D\uACE0\uB85C \uD5A5\uD569\uB2C8\uB2E4."
    enterActions: []
    choices: []
  metaProgressRequired: 0
  followUps: []
