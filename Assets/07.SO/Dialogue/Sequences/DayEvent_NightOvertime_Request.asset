  m_Name: DayEvent_NightOvertime_Request
  m_EditorClassIdentifier: DungeonKeeper.Runtime::Code.Dialogue.DialogueSequenceSO
  displayTitle: "\uBC24\uC0D8 \uC791\uC5C5\uBC18\uC758 \uC694\uCCAD"
  lines:
  - speakerName: "\uC784\uD504 \uCC38\uBAA8"
    text: "\uC8FC\uC778\uB2D8, \uBC24\uC0D8 \uB0A9\uD488\uC744 \uB9C8\uCE5C \uBD80\uD558\uB4E4\uC774 \uC26C\uACE0 \uC2F6\uB2F5\uB2C8\uB2E4.\n\uC2DD\uC0AC\uB97C \uCC59\uAE38 \uC218\uB3C4, \uCD94\uAC00 \uC8FC\uBB38\uC744 \uBC1B\uC744 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
    enterActions: []
    choices:
    - text: "\uC26C\uB294 \uB3D9\uC548 \uBA39\uC744 \uC2DD\uC0AC\uB97C \uC9C0\uC6D0\uD55C\uB2E4"
      effectSummary: "\uAE08\uD654 -15 / \uBBFC\uC2EC +6"
      actions:
      - {fileID: 11400000, guid: 6140ecac27ac83a4eb3076504304f26b, type: 2}
      - {fileID: 11400000, guid: 31079dbbd8f2da548a935e323280294e, type: 2}
      nextSequence: {fileID: 3172025519151962710}
      nextLineIndex: 0
      routes: []
    - text: "\uCD94\uAC00 \uB0A9\uD488\uC744 \uBC1B\uB294\uB2E4"
      effectSummary: "\uAE08\uD654 +35 / \uBBFC\uC2EC -6"
