  displayTitle: "\uACF5\uAD6C\uB97C \uBE4C\uB9AC\uB7EC \uC628 \uC791\uC5C5\uBC18"
  lines:
  - speakerName: "\uC784\uD504 \uCC38\uBAA8"
    text: "\uC791\uC5C5\uBC18\uC774 \uBE4C\uB9B0 \uACF5\uAD6C\uB97C \uB3CC\uB824\uC8FC\uACE0 \uC81C \uACF5\uAD6C\uB97C \uCC59\uACBC\uC2B5\uB2C8\uB2E4.\n\uB2A6\uC5C8\uC9C0\uB9CC \uB9D0\uC744 \uB4E4\uC5B4\uC92C\uB2E4\uBA70 \uC0C8 \uC790\uB8E8\uB97C \uB2E8\uB2E8\uD788 \uC961\uB2C8\uB2E4."
