  displayTitle: "\uACF5\uAD6C\uB97C \uBE4C\uB9AC\uB7EC \uC628 \uC791\uC5C5\uBC18"
  lines:
  - speakerName: "\uC784\uD504 \uCC38\uBAA8"
    text: "\uBE4C\uB9B0 \uACF5\uAD6C\uB97C \uB3CC\uB824\uAC00\uBA70 \uBC84\uD2F4 \uB355\uC5D0 \uAE08\uD654\uB294 \uB0A8\uC558\uC2B5\uB2C8\uB2E4.\n\uC784\uD504\uB4E4\uC740 \uB2E4\uC74C\uC5D0\uB3C4 \uBE4C\uB824\uC57C \uD558\uB290\uB0D0\uBA70 \uC2DC\uC120\uC744 \uD53C\uD588\uC2B5\uB2C8\uB2E4."
    enterActions: []
    choices: []
  metaProgressRequired: 0
  followUps: []
