  m_Script: {fileID: 11500000, guid: 47b6fbf626d84142a85744b0f9e1e3dc, type: 3}
  m_Name: DayEvent_ToolCooperative
  m_EditorClassIdentifier: DungeonKeeper.Runtime::Code.Dialogue.DialogueSequenceSO
  displayTitle: "\uACF5\uAD6C \uACF5\uB3D9\uAD6C\uB9E4"
  lines:
  - speakerName: "\uC784\uD504 \uCC38\uBAA8"
    text: "\uC8FC\uC778\uB2D8, \uC791\uC5C5\uBC18\uC774 \uACF5\uAD6C \uACF5\uB3D9\uAD6C\uB9E4\uB97C \uC81C\uC548\uD588\uC2B5\uB2C8\uB2E4.\n\uCC3D\uACE0\uC758 \uC608\uBE44 \uACF5\uAD6C\uB97C \uD314\uC544 \uC790\uAE08\uC744 \uB3CC\uB9B4 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
    enterActions: []
    choices:
    - text: "\uACF5\uB3D9\uAD6C\uB9E4\uC5D0 \uCC38\uC5EC\uD55C\uB2E4"
      effectSummary: "\uAE08\uD654 -15 / \uBBFC\uC2EC +4"
      actions:
      - {fileID: 11400000, guid: 6140ecac27ac83a4eb3076504304f26b, type: 2}
      - {fileID: 11400000, guid: f9a6b229b4b34b54f8f05cb83bb88237, type: 2}
      nextSequence: {fileID: 7451745374374815675}
      nextLineIndex: 0
      routes: []
    - text: "\uC608\uBE44 \uACF5\uAD6C\uB97C \uD314\uC544 \uC608\uC0B0\uC744 \uD68C\uC218\uD55C\uB2E4"
      effectSummary: "\uAE08\uD654 +35 / \uBBFC\uC2EC -6"
      actions:
      - {fileID: 11400000, guid: ea088b6deb1d40de90a45f47cd653610, type: 2}
      - {fileID: 11400000, guid: f06c646309c14f4d83a7a36263779306, type: 2}
