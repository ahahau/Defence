  displayTitle: "\uACF5\uAD6C \uACF5\uB3D9\uAD6C\uB9E4"
  lines:
  - speakerName: "\uC784\uD504 \uCC38\uBAA8"
    text: "\uC0C8 \uACF5\uAD6C\uB97C \uBC1B\uC544 \uB4E0 \uC784\uD504\uB4E4\uC774 \uC190\uC7A1\uC774\uC5D0 \uC774\uB984\uC744 \uC0C8\uACBC\uC2B5\uB2C8\uB2E4.\n\uC8FC\uC778\uB2D8\uB3C4 \uC791\uC5C5\uBC18\uC744 \uCC59\uAE34\uB2E4\uBA70 \uC11C\uB85C \uC5B4\uAE68\uB97C \uB450\uB4DC\uB9AC\uB294\uAD70\uC694."
    enterActions: []
    choices: []
  metaProgressRequired: 0
