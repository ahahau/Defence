  lines:
  - speakerName: "\uC784\uD504 \uCC38\uBAA8"
    text: "\uC8FC\uC778\uB2D8, \uD568\uAED8 \uC2DD\uC0AC\uD588\uB358 \uBD80\uD558\uB4E4\uC774 \uBB3C\uC790\uB97C \uBAA8\uC544 \uC654\uC2B5\uB2C8\uB2E4.\n\uAE08\uACE0\uC5D0 \uBCF4\uD0E4\uC9C0 \uC790\uAE30\uB4E4 \uBAAB\uC73C\uB85C \uB458\uC9C0 \uBB3C\uC5B4\uBCF4\uB294\uAD70\uC694."
    enterActions: []
    choices:
    - text: "\uBAA8\uC544 \uC628 \uBB3C\uC790\uB97C \uBC1B\uB294\uB2E4"
      effectSummary: "\uAE08\uD654 +35"
      actions:
      - {fileID: 11400000, guid: ea088b6deb1d40de90a45f47cd653610, type: 2}
      nextSequence: {fileID: 7833629387909542178}
      nextLineIndex: 0
      routes: []
    - text: "\uBD80\uD558\uB4E4\uC758 \uBAAB\uC73C\uB85C \uB0A8\uAE34\uB2E4"
