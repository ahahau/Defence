  m_Script: {fileID: 11500000, guid: 47b6fbf626d84142a85744b0f9e1e3dc, type: 3}
  m_Name: DayEvent_NightOvertime
  m_EditorClassIdentifier: DungeonKeeper.Runtime::Code.Dialogue.DialogueSequenceSO
  displayTitle: "\uC57C\uAC04 \uCD94\uAC00 \uADFC\uBB34"
  lines:
  - speakerName: "\uC784\uD504 \uCC38\uBAA8"
    text: "\uC8FC\uC778\uB2D8, \uC57C\uAC04 \uC791\uC5C5\uC73C\uB85C \uB0A8\uC740 \uBB3C\uC790\uB97C \uD314\uC790\uB294 \uC81C\uC548\uC785\uB2C8\uB2E4.\n\uB300\uC2E0 \uBD80\uD558\uB4E4\uC744 \uC26C\uAC8C \uD558\uACE0 \uC2DD\uC0AC\uB97C \uB300\uC811\uD560 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
    enterActions: []
    choices:
    - text: "\uC790\uC6D0\uC790\uB97C \uBAA8\uC544 \uC57C\uAC04 \uC791\uC5C5\uC744 \uD55C\uB2E4"
      effectSummary: "\uAE08\uD654 +35 / \uBBFC\uC2EC -6"
      actions:
      - {fileID: 11400000, guid: ea088b6deb1d40de90a45f47cd653610, type: 2}
      - {fileID: 11400000, guid: f06c646309c14f4d83a7a36263779306, type: 2}
      nextSequence: {fileID: 992927807614568080}
      nextLineIndex: 0
      routes: []
    - text: "\uCD94\uAC00 \uADFC\uBB34 \uB300\uC2E0 \uC2DD\uC0AC\uB97C \uB300\uC811\uD55C\uB2E4"
      effectSummary: "\uAE08\uD654 -15 / \uBBFC\uC2EC +6"
      actions:
      - {fileID: 11400000, guid: 6140ecac27ac83a4eb3076504304f26b, type: 2}
