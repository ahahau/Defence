  displayTitle: "\uC57C\uAC04 \uCD94\uAC00 \uADFC\uBB34"
  lines:
  - speakerName: "\uC784\uD504 \uCC38\uBAA8"
    text: "\uBC24\uC0C8 \uC815\uB9AC\uD55C \uBB3C\uC790\uB97C \uD314\uC544 \uAE08\uD654\uB97C \uB9C8\uB828\uD588\uC2B5\uB2C8\uB2E4.\n\uC544\uCE68 \uC2DD\uD0C1\uC5D0\uC11C\uB294 \uD53C\uACE4\uD55C \uC784\uD504\uB4E4\uC758 \uD55C\uC228\uC774 \uBA3C\uC800 \uB4E4\uB9BD\uB2C8\uB2E4."
    enterActions: []
    choices: []
  metaProgressRequired: 0
  followUps: []
